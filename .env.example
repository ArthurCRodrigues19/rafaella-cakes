# =============================================================
#  Rafaella Cakes — variáveis de ambiente
#  Copie este arquivo para ".env" (na mesma pasta) e ajuste.
#  O .env é lido tanto pela API quanto pelo site.
# =============================================================

# ---------- Geral ----------
NODE_ENV=development
# Endereço do site (Next.js) e da API (Express)
WEB_URL=http://localhost:3000
API_URL=http://localhost:4000
API_PORT=4000

# ---------- Banco de dados (PostgreSQL) ----------
# Com o docker-compose do projeto, não precisa mudar nada.
DATABASE_URL=postgresql://rafaella:rafaella@localhost:5432/rafaella_cakes?schema=public

# ---------- Autenticação ----------
# Gere um valor aleatório longo (ex.: https://generate-secret.vercel.app/64)
JWT_SECRET=troque-este-segredo-por-um-valor-bem-longo-e-aleatorio
# Duração da sessão (em dias)
SESSION_DAYS=7

# Login com Google (opcional — deixe vazio para desativar)
# Redirect URI autorizado no Google Cloud: http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------- Admin criado pelo seed ----------
SEED_ADMIN_EMAIL=admin@rafaellacakes.com.br
SEED_ADMIN_PASSWORD=Rafaella@2026

# ---------- E-mail (SMTP) ----------
# Em desenvolvimento, o Mailpit (docker) recebe todos os e-mails: http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Rafaella Cakes <contato@rafaellacakes.com.br>"
# E-mail que recebe avisos de novos pedidos, encomendas e mensagens de contato
STORE_NOTIFY_EMAIL=rafaella@rafaellacakes.com.br

# ---------- Pagamentos (Mercado Pago) ----------
# Deixe vazio para usar o MODO DE DEMONSTRAÇÃO (pagamentos simulados).
# Credenciais de teste: https://www.mercadopago.com.br/developers/panel/app
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=
# Chave secreta das notificações (Webhooks) — opcional, valida a assinatura
MP_WEBHOOK_SECRET=
# URL pública (https) da API para o Mercado Pago enviar webhooks.
# Em ambiente local use um túnel (ex.: ngrok). Se vazio, o site consulta o status sozinho.
MP_NOTIFICATION_URL=

# ---------- Instagram (opcional) ----------
# Token de longa duração da Instagram API. Se vazio, o site mostra posts de exemplo.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_POSTS_LIMIT=8
